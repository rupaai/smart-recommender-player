<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is allowed for every host on purpose. This is a LAN-only app and the
  server address (usually a private IP such as http://192.168.1.20:8000) is typed in by
  the user at runtime. A <domain-config> can only name hosts known at build time and
  cannot cover arbitrary IP addresses, so a base-config is the only option.
  The app only talks to the user-chosen server (WebView navigation is pinned to its
  origin, see MainActivity) and holds no secrets.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
