# Copy to /srv/couchcinema/.env (bootstrap.sh writes it for you). Keep it out of git.

# Image tag to run, e.g. sha-<commit>. Set by deploy.sh.
IMAGE_TAG=
# Folder holding Movies, Shows and downloads. /srv/media now, /mnt/media after the drive move.
MEDIA_ROOT=
# Group id of the host's `render` group, so Jellyfin can use /dev/dri.
RENDER_GID=
# Users the containers run as. Leave unset on plain Docker; bootstrap.sh sets 0:0 / 0 / 0
# under rootless Docker, where container root is the unprivileged deploy user.
APP_USER=
SVC_PUID=
SVC_PGID=

# TMDB API key (from your Mac's .env).
TMDB_API_KEY=
# Jellyfin: only exist after its first-run wizard. Add later with bootstrap.sh --set.
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=
# Prowlarr API key (Settings > General in Prowlarr, or your Mac's .env).
PROWLARR_API_KEY=
# Bearer token for /admin on the app. Generated by bootstrap.sh.
ADMIN_TOKEN=
# Private ntfy topic for deploy and alert messages (generated by bootstrap.sh).
NTFY_TOPIC=
# ntfy server. Leave unset for https://ntfy.sh.
NTFY_SERVER=
# healthchecks.io ping URL for the 5-minute heartbeat (optional; created on healthchecks.io).
HEALTHCHECKS_URL=
