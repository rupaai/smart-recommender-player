<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TEMPLATE - not meant to be loaded as-is.

  The placeholders __REPO__ and __HOME__ are literal text. ops/mac/install.sh
  replaces them with real absolute paths before copying this file into
  ~/Library/LaunchAgents/. Loading this file unmodified will fail.

  Schedule: launchd starts it every hour at :30. nightly.sh (with
  scheduled) does the night's work once a day, from 03:30, the first time the
  server can be reached, and otherwise exits quietly. So a Mac that is asleep
  or off at 03:30 runs it the first hour it is on and online. (launchd only
  catches up a missed time after sleep, not after a shutdown, and a sleeping
  Mac often has no network when it does: hence hourly.)
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.couchcinema.nightly</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__REPO__/ops/mac/nightly.sh</string>
		<string>--scheduled</string>
	</array>

	<key>WorkingDirectory</key>
	<string>__REPO__</string>

	<key>StartCalendarInterval</key>
	<dict>
		<key>Minute</key>
		<integer>30</integer>
	</dict>

	<key>RunAtLoad</key>
	<false/>

	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/CouchCinema/launchd.log</string>

	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/CouchCinema/launchd.log</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<!-- uv lives in ~/.local/bin or Homebrew -->
		<key>PATH</key>
		<string>__HOME__/.local/bin:__HOME__/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>

	<key>ProcessType</key>
	<string>Background</string>

	<key>LowPriorityIO</key>
	<true/>

	<key>Nice</key>
	<integer>5</integer>
</dict>
</plist>
